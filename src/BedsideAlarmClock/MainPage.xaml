<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BedsideAlarmClock.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#000000">
    <Grid x:Name="ClockLayout"
          Padding="20"
          RowDefinitions="*,Auto,Auto"
          SizeChanged="OnClockLayoutSizeChanged">
        <Grid x:Name="ClockSafeArea"
              SizeChanged="OnClockSafeAreaSizeChanged">
            <VerticalStackLayout x:Name="ClockContent"
                                 HorizontalOptions="Fill"
                                 VerticalOptions="Center"
                                 Spacing="12">
                <Label x:Name="TimeLabel"
                       HorizontalOptions="Center"
                       FontSize="96"
                       FontAttributes="Bold"
                       TextColor="#D8D8D8"
                       LineBreakMode="NoWrap"
                       HandlerChanged="OnTimeLabelHandlerChanged"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label x:Name="DateLabel"
                       HorizontalOptions="Center"
                       FontSize="18"
                       TextColor="#858585"
                       SizeChanged="OnClockSafeAreaSizeChanged"
                       SemanticProperties.HeadingLevel="Level2" />
            </VerticalStackLayout>
        </Grid>

        <Button x:Name="SkipButton"
                Grid.Row="0"
                Text="SKIP"
                FontSize="13"
                BackgroundColor="#A62222"
                TextColor="White"
                HorizontalOptions="Start"
                VerticalOptions="End"
                IsVisible="False"
                Clicked="OnSkipClicked"
                SemanticProperties.Hint="Skip the next upcoming alarm" />

        <ScrollView x:Name="AlarmControls"
                    Grid.Row="1"
                    MaximumHeightRequest="180"
                    IsVisible="False">
            <VerticalStackLayout x:Name="ActiveAlarmList"
                                 HorizontalOptions="Center"
                                 Spacing="8" />
        </ScrollView>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
            <Label x:Name="NextAlarmLabel"
                   FontSize="13"
                   TextColor="#A0A0A0"
                   VerticalOptions="Center"
                   LineBreakMode="WordWrap"
                   Text="Loading alarm..." />
            <HorizontalStackLayout Grid.Column="1">
                <Button Text="Alarms"
                        FontSize="13"
                        TextColor="#A0A0A0"
                        BackgroundColor="Transparent"
                        Clicked="OnAlarmsClicked"
                        SemanticProperties.Hint="Open alarm setup" />
                <Button Text="Settings"
                        FontSize="13"
                        TextColor="#A0A0A0"
                        BackgroundColor="Transparent"
                        Clicked="OnSettingsClicked"
                        SemanticProperties.Hint="Open clock settings" />
            </HorizontalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
