<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BedsideAlarmClock.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#000000">
    <Grid x:Name="ClockLayout"
          Padding="20"
          SizeChanged="OnClockLayoutSizeChanged">
        <Grid x:Name="ClockSafeArea"
              SizeChanged="OnClockSafeAreaSizeChanged">
            <VerticalStackLayout x:Name="ClockContent"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="12">
                <Label x:Name="TimeLabel"
                       HorizontalOptions="Center"
                       FontSize="96"
                       FontAttributes="Bold"
                       TextColor="#D8D8D8"
                       LineBreakMode="NoWrap"
                       HandlerChanged="OnTimeLabelHandlerChanged"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label x:Name="DateLabel"
                       HorizontalOptions="Center"
                       FontSize="18"
                       TextColor="#858585"
                       SemanticProperties.HeadingLevel="Level2" />
            </VerticalStackLayout>
        </Grid>

        <HorizontalStackLayout HorizontalOptions="End"
                               VerticalOptions="End">
            <Button Text="Alarms"
                    FontSize="13"
                    TextColor="#A0A0A0"
                    BackgroundColor="Transparent"
                    Clicked="OnAlarmsClicked"
                    SemanticProperties.Hint="Open alarm setup" />
            <Button Text="Settings"
                    FontSize="13"
                    TextColor="#A0A0A0"
                    BackgroundColor="Transparent"
                    Clicked="OnSettingsClicked"
                    SemanticProperties.Hint="Open clock settings" />
        </HorizontalStackLayout>
    </Grid>
</ContentPage>
