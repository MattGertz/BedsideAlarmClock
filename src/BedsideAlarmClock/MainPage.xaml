<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BedsideAlarmClock.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#000000">
    <Grid x:Name="ClockLayout"
          Padding="20"
          RowDefinitions="*,Auto"
          SizeChanged="OnClockLayoutSizeChanged">
        <Grid x:Name="ClockSafeArea"
              SizeChanged="OnClockSafeAreaSizeChanged">
            <VerticalStackLayout x:Name="ClockContent"
                                 HorizontalOptions="Fill"
                                 VerticalOptions="Center"
                                 Spacing="12">
                <Label x:Name="TimeLabel"
                       HorizontalOptions="Center"
                       FontSize="96"
                       FontAttributes="Bold"
                       TextColor="#D8D8D8"
                       LineBreakMode="NoWrap"
                       HandlerChanged="OnTimeLabelHandlerChanged"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label x:Name="DateLabel"
                       HorizontalOptions="Center"
                       FontSize="18"
                       TextColor="#858585"
                       SizeChanged="OnClockSafeAreaSizeChanged"
                       SemanticProperties.HeadingLevel="Level2" />
                <Label x:Name="NextAlarmLabel"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       FontSize="13"
                       Style="{StaticResource NextAlarmLabelStyle}"
                       LineBreakMode="WordWrap"
                       SizeChanged="OnClockSafeAreaSizeChanged"
                       Text="Loading alarm..." />
            </VerticalStackLayout>
        </Grid>

        <ImageButton x:Name="SkipButton"
                     Grid.Row="0"
                     Source="skip_alarm.png"
                     Style="{StaticResource ClockNavigationButtonStyle}"
                     HorizontalOptions="Start"
                     VerticalOptions="End"
                     IsVisible="False"
                     Clicked="OnSkipClicked"
                     SemanticProperties.Description="Skip next alarm"
                     SemanticProperties.Hint="Skip the next upcoming alarm" />

        <ScrollView x:Name="AlarmControls"
                    Grid.Row="1"
                    MaximumHeightRequest="180"
                    IsVisible="False">
            <VerticalStackLayout x:Name="ActiveAlarmList"
                                 HorizontalOptions="Center"
                                 Spacing="8" />
        </ScrollView>

        <HorizontalStackLayout x:Name="NavigationControls"
                               Grid.Row="0"
                               HorizontalOptions="End"
                               VerticalOptions="End"
                               IsVisible="False">
            <ImageButton Source="alarm_button.png"
                         Style="{StaticResource ClockNavigationButtonStyle}"
                         Clicked="OnAlarmsClicked"
                         SemanticProperties.Description="Alarms"
                         SemanticProperties.Hint="Open alarm setup" />
            <ImageButton Source="settings_gear.png"
                         Style="{StaticResource ClockNavigationButtonStyle}"
                         Clicked="OnSettingsClicked"
                         SemanticProperties.Description="Settings"
                         SemanticProperties.Hint="Open clock settings" />
        </HorizontalStackLayout>
    </Grid>
</ContentPage>
