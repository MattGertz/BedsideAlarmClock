<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BedsideAlarmClock.AlarmListPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#000000">
    <Grid RowDefinitions="Auto,Auto,*"
          Padding="20,12"
          RowSpacing="12">
        <Grid ColumnDefinitions="Auto,*,Auto">
            <Button Text="&#x2190;" Clicked="OnBackClicked"
                    WidthRequest="48" HeightRequest="48" Padding="0"
                    FontSize="26" BackgroundColor="Transparent" TextColor="#D8D8D8"
                    SemanticProperties.Description="Back to clock" />
            <Label Grid.Column="1" Text="Alarms" FontSize="26"
                   FontAttributes="Bold" TextColor="#EEEEEE"
                   VerticalOptions="Center" SemanticProperties.HeadingLevel="Level1" />
            <Button x:Name="AddButton" Grid.Column="2" Text="+ Add"
                    Clicked="OnAddClicked" TextColor="#FFFFFF"
                    BackgroundColor="#333333" SemanticProperties.Description="Add alarm" />
        </Grid>
        <VerticalStackLayout Grid.Row="1">
            <Label x:Name="DeliveryStatus" Text="Setup only: alarms will not ring yet."
                   TextColor="#FFD180" FontSize="15"
                   SemanticProperties.HeadingLevel="Level2" />
            <Button x:Name="ActiveControlsButton" Text="Open active alarm controls"
                    IsVisible="False" Clicked="OnActiveControlsClicked" />
        </VerticalStackLayout>
        <ScrollView Grid.Row="2">
            <VerticalStackLayout x:Name="AlarmRows" Spacing="8" />
        </ScrollView>
    </Grid>
</ContentPage>
