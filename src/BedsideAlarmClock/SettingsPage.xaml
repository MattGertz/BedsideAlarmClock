<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BedsideAlarmClock.SettingsPage"
             Title="Settings"
             BackgroundColor="#000000">
    <ScrollView>
    <VerticalStackLayout Padding="24,16"
                         Spacing="20">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="16">
            <VerticalStackLayout Spacing="4"
                                 VerticalOptions="Center">
                <Label Text="24-hour time"
                       FontSize="18"
                       TextColor="#D8D8D8" />
                <Label Text="Use a 24-hour clock instead of AM/PM"
                       FontSize="14"
                       TextColor="#858585" />
            </VerticalStackLayout>
            <Switch x:Name="Use24HourTimeSwitch"
                    Grid.Column="1"
                    VerticalOptions="Center"
                    SemanticProperties.Description="Use 24-hour time" />
        </Grid>

        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="16">
            <VerticalStackLayout Spacing="4"
                                 VerticalOptions="Center">
                <Label Text="Show seconds"
                       FontSize="18"
                       TextColor="#D8D8D8" />
                <Label Text="Update the clock every second"
                       FontSize="14"
                       TextColor="#858585" />
            </VerticalStackLayout>
            <Switch x:Name="ShowSecondsSwitch"
                    Grid.Column="1"
                    VerticalOptions="Center"
                    SemanticProperties.Description="Show seconds on the clock" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="16">
            <Label Text="Show date"
                   FontSize="18"
                   TextColor="#D8D8D8"
                   VerticalOptions="Center" />
            <Switch x:Name="ShowDateSwitch"
                    Grid.Column="1"
                    VerticalOptions="Center"
                    SemanticProperties.Description="Show the date on the clock" />
        </Grid>

        <VerticalStackLayout Spacing="4">
            <Label Text="Clock font"
                   FontSize="18"
                   TextColor="#D8D8D8" />
            <Picker x:Name="ClockFontPicker"
                    Title="Select a clock font"
                    TextColor="#D8D8D8"
                    TitleColor="#858585"
                    SemanticProperties.Description="Clock font" />
        </VerticalStackLayout>
        <VerticalStackLayout Spacing="8">
            <Label Text="Alarm permissions" FontSize="18" TextColor="#D8D8D8" />
            <Label x:Name="AlarmPermissionStatus" FontSize="14" TextColor="#FFD180" />
            <Button Text="Notification settings" Clicked="OnNotificationSettingsClicked" />
            <Button Text="Exact alarm settings" Clicked="OnExactAlarmSettingsClicked" />
            <Button Text="Full-screen alarm settings" Clicked="OnFullScreenSettingsClicked" />
        </VerticalStackLayout>
    </VerticalStackLayout>
    </ScrollView>
</ContentPage>
